. ** 9. Una regresión por grupo, guardada en una matriz y exportada
. levelsof sector, local(sectores)
`"Agricultura"' `"Comercio"' `"Construcción"' `"Educación"' `"Industria"' `"Servicios"'

. local n : word count `sectores'

. matrix resultados = J(`n', 3, .)

. matrix colnames resultados = coef_educ error_est n

. 
. local i = 1

. foreach s of local sectores {
  2.     quietly regress `depvar' educ if sector == "`s'"
  3.     matrix resultados[`i', 1] = _b[educ]
  4.     matrix resultados[`i', 2] = _se[educ]
  5.     matrix resultados[`i', 3] = e(N)
  6.     local ++i
  7. }

. matrix list resultados

resultados[6,3]
    coef_educ  error_est          n
r1  37519.129  7556.4817         13
r2  24487.097  8528.8386          6
r3  23782.609  14122.299          5
r4  37368.421  12642.389          7
r5  42712.644  14513.917          9
r6  32307.531  7924.2754         15

. 
. putexcel set "output/tarea_t5_por_sector.xlsx", replace

. putexcel A1 = ("sector") B1 = ("coef_educ") C1 = ("error_est") D1 = ("n")
file output/tarea_t5_por_sector.xlsx saved

. putexcel B2 = matrix(resultados)
file output/tarea_t5_por_sector.xlsx saved

. 
. local fila = 2

. foreach s of local sectores {
  2.     putexcel A`fila' = ("`s'")
  3.     local ++fila
  4. }
file output/tarea_t5_por_sector.xlsx saved
